# Server Configuration
PORT=8090
HOST=0.0.0.0

# Target tmux session and CLI harness
TMUX_SESSION=agent-session
CLI_COMMAND=bash

# Terminal dimensions
PTY_COLS=120
PTY_ROWS=40

# Cloudflare Zero Trust (ZTNA) Service Token (Optional)
# If provided, requests and WebSocket upgrades must match these headers
# CF_ACCESS_CLIENT_ID=your-service-token-id.access
# CF_ACCESS_CLIENT_SECRET=your-service-token-secret
